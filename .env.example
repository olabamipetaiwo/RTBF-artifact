# Optional settings. Copy this file to .env to change them; the defaults work as they are.
# Logging in is described in docs/sessions.md (no passwords or cookies go in this file).

# Workbook the pipeline reads test cases from and writes results to.
# DIDR_WORKBOOK=data/DIDR Test Cases.xlsx

# Folders for login sessions, run state, and evidence (transcripts, screenshots).
# DIDR_SESSIONS_DIR=sessions
# DIDR_STATE_DIR=data/state
# DIDR_RESULTS_DIR=results

# Drive Copilot through your own Chrome window (README, "Copilot in your own Chrome").
# DIDR_COPILOT_CDP=http://localhost:9222

# 1 runs the browser without a window. Several agents block such browsers, so leave it at 0.
# DIDR_HEADLESS=0
